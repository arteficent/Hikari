<?xml version="1.0" encoding="utf-8"?>
<views:HikariPage
    x:Class="Hikari.WindowsClient.Views.LoadingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Hikari.WindowsClient.Views"
    Background="{StaticResource HikariBackgroundBrush}">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
        <TextBlock
            Text="光"
            FontSize="64"
            HorizontalAlignment="Center"
            Foreground="{StaticResource HikariPrimaryBrush}" />
        <ProgressRing IsActive="True" Width="36" Height="36" Foreground="{StaticResource HikariPrimaryBrush}" />
        <TextBlock
            Text="Restoring session…"
            HorizontalAlignment="Center"
            Style="{StaticResource HikariCaptionStyle}" />
    </StackPanel>
</views:HikariPage>
