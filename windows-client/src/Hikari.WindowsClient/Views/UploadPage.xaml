<?xml version="1.0" encoding="utf-8"?>
<views:HikariPage
    x:Class="Hikari.WindowsClient.Views.UploadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hikari.WindowsClient.Controls"
    xmlns:views="using:Hikari.WindowsClient.Views"
    Background="{StaticResource HikariBackgroundBrush}">

    <Grid Padding="20,14,20,14" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button Click="OnBackClicked" ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="15" Foreground="{StaticResource HikariPrimaryBrush}" />
            </Button>
            <TextBlock x:Name="TitleLabel" VerticalAlignment="Center"
                       FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource HikariPrimaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">

                <!-- ── File ── -->
                <Border Style="{StaticResource PaperSurfaceStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="FILE" Style="{StaticResource HikariSectionLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="PickFileButton" Click="OnPickFileClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="15" />
                                    <TextBlock x:Name="PickFileLabel" Text="Pick file" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="FileNameLabel" VerticalAlignment="Center"
                                       Style="{StaticResource HikariBodyStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="EditHintLabel" Visibility="Collapsed"
                                   Style="{StaticResource HikariCaptionStyle}" TextWrapping="Wrap"
                                   Text="Leave the file empty to update metadata only; pick a file to replace the stored binary." />
                    </StackPanel>
                </Border>

                <!-- ── Common fields ── -->
                <Border Style="{StaticResource PaperSurfaceStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="DETAILS" Style="{StaticResource HikariSectionLabelStyle}" />
                        <TextBox x:Name="TitleBox" Header="Title *" />
                        <TextBox x:Name="DescriptionBox" Header="Description" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
                        <TextBox x:Name="TagsBox" Header="Tags (comma separated)" />
                    </StackPanel>
                </Border>

                <!-- ── Plugin fields ── -->
                <Border x:Name="PluginFieldsCard" Style="{StaticResource PaperSurfaceStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="PluginFieldsLabel" Style="{StaticResource HikariSectionLabelStyle}" />
                        <controls:DynamicForm x:Name="PluginForm" />
                    </StackPanel>
                </Border>

                <!-- ── Embedded metadata + cover ── -->
                <Border Style="{StaticResource PaperSurfaceStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="EMBEDDED METADATA" Style="{StaticResource HikariSectionLabelStyle}" />
                        <CheckBox x:Name="RewriteMetadataCheck" Content="Update metadata inside the file" />
                        <TextBlock Style="{StaticResource HikariCaptionStyle}" TextWrapping="Wrap"
                                   Text="When checked, the file's embedded tags are stripped and rewritten with the values above before uploading." />

                        <StackPanel x:Name="CoverPanel" Orientation="Horizontal" Spacing="14" Visibility="Collapsed">
                            <Border Width="82" Height="82" CornerRadius="8"
                                    Background="{StaticResource HikariPrimarySoftBrush}">
                                <Grid>
                                    <TextBlock Text="—" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource HikariTextSoftBrush}" />
                                    <Image x:Name="CoverPreview" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="PickCoverButton" Click="OnPickCoverClicked" />
                                    <Button x:Name="UndoCoverButton" Content="Undo" Click="OnUndoCoverClicked" Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock x:Name="CoverStatusLabel" Style="{StaticResource HikariCaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="CoverWarningLabel" Visibility="Collapsed" FontSize="12.5"
                                           TextWrapping="Wrap" Foreground="IndianRed" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="8" MaxWidth="760" HorizontalAlignment="Left">
            <ProgressBar x:Name="UploadProgress" Visibility="Collapsed" IsIndeterminate="True"
                         Foreground="{StaticResource HikariPrimaryBrush}" />
            <Button x:Name="SubmitButton" Click="OnSubmitClicked" Style="{StaticResource AccentButtonStyle}" MinWidth="200">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="SubmitRing" IsActive="False" Visibility="Collapsed" Width="15" Height="15" />
                    <FontIcon x:Name="SubmitIcon" Glyph="&#xE898;" FontSize="15" />
                    <TextBlock x:Name="SubmitLabel" Text="Upload" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</views:HikariPage>
