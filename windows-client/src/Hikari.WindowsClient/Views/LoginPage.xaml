<?xml version="1.0" encoding="utf-8"?>
<views:HikariPage
    x:Class="Hikari.WindowsClient.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Hikari.WindowsClient.Views"
    Background="{StaticResource HikariBackgroundBrush}">

    <Grid Padding="32">
        <Border Style="{StaticResource PaperSurfaceStyle}"
                MaxWidth="480"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <TextBlock Text="Sign In" Style="{StaticResource HikariHeadlineStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="DomainLabel" Style="{StaticResource HikariCaptionStyle}"
                           HorizontalAlignment="Center" />

                <TextBox x:Name="UsernameBox" Header="Username" KeyDown="OnFieldKeyDown" />
                <PasswordBox x:Name="PasswordBox" Header="Password" KeyDown="OnFieldKeyDown" />

                <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" />

                <Button x:Name="SignInButton"
                        Click="OnSignInClicked"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed" Width="16" Height="16" />
                        <FontIcon x:Name="SignInIcon" Glyph="&#xE77B;" FontSize="15" />
                        <TextBlock Text="Sign in" />
                    </StackPanel>
                </Button>

                <HyperlinkButton Content="Change server" Click="OnChangeServerClicked" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</views:HikariPage>
