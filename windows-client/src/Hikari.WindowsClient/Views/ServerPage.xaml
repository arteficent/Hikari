<?xml version="1.0" encoding="utf-8"?>
<views:HikariPage
    x:Class="Hikari.WindowsClient.Views.ServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Hikari.WindowsClient.Views"
    Background="{StaticResource HikariBackgroundBrush}">

    <Grid Padding="32">
        <Border Style="{StaticResource PaperSurfaceStyle}"
                MaxWidth="520"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <TextBlock Text="光" FontSize="44" HorizontalAlignment="Center"
                           Foreground="{StaticResource HikariPrimaryBrush}" />
                <TextBlock Text="Connect to Server" Style="{StaticResource HikariHeadlineStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource HikariCaptionStyle}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="Point Hikari at your sync-server. Host name or IP, with an optional port." />

                <TextBox x:Name="DomainBox"
                         Header="Server address"
                         PlaceholderText="hikari.example.com  ·  192.168.1.10:8080"
                         KeyDown="OnDomainKeyDown" />

                <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" />

                <Button x:Name="ConnectButton"
                        Click="OnConnectClicked"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed" Width="16" Height="16" />
                        <FontIcon x:Name="ConnectIcon" Glyph="&#xE968;" FontSize="15" />
                        <TextBlock Text="Continue" />
                    </StackPanel>
                </Button>

                <HyperlinkButton x:Name="LibraryButton"
                                 Click="OnChooseLibraryClicked"
                                 HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</views:HikariPage>
