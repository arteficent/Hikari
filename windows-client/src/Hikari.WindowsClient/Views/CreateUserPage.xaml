<?xml version="1.0" encoding="utf-8"?>
<views:HikariPage
    x:Class="Hikari.WindowsClient.Views.CreateUserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Hikari.WindowsClient.Views"
    Background="{StaticResource HikariBackgroundBrush}">

    <Grid Padding="24">
        <Border Style="{StaticResource PaperSurfaceStyle}"
                MaxWidth="480" Padding="28"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Click="OnBackClicked" ToolTipService.ToolTip="Back">
                        <FontIcon Glyph="&#xE72B;" FontSize="15" Foreground="{StaticResource HikariPrimaryBrush}" />
                    </Button>
                    <TextBlock Text="Create user" VerticalAlignment="Center"
                               Style="{StaticResource HikariHeadlineStyle}" />
                </StackPanel>

                <TextBox x:Name="UsernameBox" Header="Username" />
                <PasswordBox x:Name="PasswordBox" Header="Password (minimum 8 characters)" />

                <StackPanel x:Name="RolePanel" Spacing="6">
                    <TextBlock Text="ROLE" Style="{StaticResource HikariSectionLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton x:Name="UserRadio" Content="User" IsChecked="True" GroupName="Role" />
                        <RadioButton x:Name="AdminRadio" Content="Admin" GroupName="Role" />
                    </StackPanel>
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" />

                <Button x:Name="CreateButton" Click="OnCreateClicked"
                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed" Width="15" Height="15" />
                        <FontIcon x:Name="CreateIcon" Glyph="&#xE8FA;" FontSize="15" />
                        <TextBlock Text="Create user" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</views:HikariPage>
