<?xml version="1.0" encoding="utf-8"?>
<views:HikariPage
    x:Class="Hikari.WindowsClient.Views.UserListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Hikari.WindowsClient.Views"
    Background="{StaticResource HikariBackgroundBrush}">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Click="OnBackClicked" ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" Foreground="{StaticResource HikariPrimaryBrush}" />
                </Button>
                <TextBlock Text="Manage users" VerticalAlignment="Center"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource HikariPrimaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Click="OnRefreshClicked" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" Foreground="{StaticResource HikariPrimaryBrush}" />
                </Button>
                <Button Click="OnCreateUserClicked" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8FA;" FontSize="15" />
                        <TextBlock Text="New user" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="UsersList" SelectionMode="None" MaxWidth="720" HorizontalAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:UserRowViewModel">
                        <Border Style="{StaticResource PaperSurfaceStyle}" Padding="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Username, Mode=OneWay}" Style="{StaticResource HikariTitleStyle}" />
                                    <TextBlock Text="{x:Bind RolesDisplay, Mode=OneWay}" Style="{StaticResource HikariCaptionStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ActionsVisibility}">
                                    <Button Click="OnToggleAdmin"
                                            ToolTipService.ToolTip="{x:Bind AdminToggleTooltip, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE734;" FontSize="15"
                                                      Foreground="{x:Bind AdminBrush, Mode=OneWay}" />
                                            <TextBlock Text="Admin" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnRemoveUser" ToolTipService.ToolTip="Remove user">
                                        <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="IndianRed" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="36" Height="36"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="{StaticResource HikariPrimaryBrush}" />
        </Grid>
    </Grid>
</views:HikariPage>
