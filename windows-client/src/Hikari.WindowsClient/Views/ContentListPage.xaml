<?xml version="1.0" encoding="utf-8"?>
<views:HikariPage
    x:Class="Hikari.WindowsClient.Views.ContentListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hikari.WindowsClient.Controls"
    xmlns:views="using:Hikari.WindowsClient.Views"
    Background="{StaticResource HikariBackgroundBrush}">

    <Grid Padding="20,14,20,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Header + actions ── -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Click="OnBackClicked" ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" Foreground="{StaticResource HikariPrimaryBrush}" />
                </Button>
                <TextBlock x:Name="TitleLabel" VerticalAlignment="Center"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource HikariPrimaryBrush}" />
                <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Style="{StaticResource HikariCaptionStyle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Click="OnRefreshClicked" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" Foreground="{StaticResource HikariPrimaryBrush}" />
                </Button>

                <Button x:Name="DeleteButton" Click="OnBatchDeleteClicked" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="IndianRed" />
                        <TextBlock x:Name="DeleteLabel" Text="Delete" />
                    </StackPanel>
                </Button>

                <Button x:Name="UploadButton" Click="OnUploadClicked" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE898;" FontSize="15" />
                        <TextBlock Text="Upload" />
                    </StackPanel>
                </Button>

                <!--
                    Sync stays enabled no matter what is marked: it reconciles disk with
                    the marked set, so unmarking the last item and pressing Sync must
                    still delete it locally.
                -->
                <Button x:Name="SyncButton" Click="OnSyncClicked"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Download marked items and remove unmarked ones from this PC">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing x:Name="SyncRing" IsActive="False" Visibility="Collapsed" Width="15" Height="15" />
                        <FontIcon x:Name="SyncIcon" Glyph="&#xE895;" FontSize="15" />
                        <TextBlock Text="Sync" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── Filters ── -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FilterBox" Grid.Column="0"
                     PlaceholderText="Filter with a regular expression — matches title, description, tags and metadata"
                     TextChanged="OnFilterChanged" />

            <Button Grid.Column="1" Click="OnFilterHelpClicked" ToolTipService.ToolTip="Regex filter guide">
                <FontIcon Glyph="&#xE897;" FontSize="15" Foreground="{StaticResource HikariPrimaryBrush}" />
            </Button>

            <ToggleButton x:Name="ServerFilterToggle" Grid.Column="2" Click="OnServerFilterToggled"
                          ToolTipService.ToolTip="Server-side filters">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE71C;" FontSize="15" />
                    <TextBlock Text="Fields" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!-- Server-side filter panel, built from the plugin's declared FilterFields -->
        <Border x:Name="ServerFilterPanel" Grid.Row="2"
                Style="{StaticResource PaperSurfaceStyle}"
                Padding="16" Visibility="Collapsed">
            <StackPanel Spacing="10">
                <controls:DynamicForm x:Name="FilterForm" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Clear" Click="OnClearServerFiltersClicked" />
                    <Button Content="Apply" Click="OnApplyServerFiltersClicked" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Pagination ── -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="PrevButton" Click="OnPrevPageClicked" ToolTipService.ToolTip="Previous page">
                <FontIcon Glyph="&#xE76B;" FontSize="13" />
            </Button>
            <TextBlock x:Name="PageLabel" VerticalAlignment="Center" Style="{StaticResource HikariBodyStyle}" />
            <Button x:Name="NextButton" Click="OnNextPageClicked" ToolTipService.ToolTip="Next page">
                <FontIcon Glyph="&#xE76C;" FontSize="13" />
            </Button>
            <NumberBox x:Name="PageSizeBox" Value="25" Minimum="5" Maximum="200"
                       SpinButtonPlacementMode="Compact" Width="128"
                       ValueChanged="OnPageSizeChanged" />
            <TextBlock Text="per page" VerticalAlignment="Center" Style="{StaticResource HikariCaptionStyle}" />
        </StackPanel>

        <!-- ── Items ── -->
        <Grid Grid.Row="4">
            <ListView x:Name="ItemsList" SelectionMode="None" Padding="0,0,8,8">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:ContentItemViewModel">
                        <Border Style="{StaticResource PaperSurfaceStyle}" Padding="12">
                            <StackPanel>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Cover art, falling back to the plugin glyph -->
                                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8"
                                            Background="{StaticResource HikariPrimarySoftBrush}">
                                        <Grid>
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="30"
                                                      Foreground="{StaticResource HikariPrimaryBrush}" />
                                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource HikariTitleStyle}" />
                                        <TextBlock Text="{x:Bind Secondary}" Style="{StaticResource HikariCaptionStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Click="OnToggleDetails" Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="Details">
                                            <FontIcon Glyph="&#xE946;" FontSize="15"
                                                      Foreground="{StaticResource HikariTextSoftBrush}" />
                                        </Button>

                                        <Button Click="OnItemSyncToggle" Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="{x:Bind SyncTooltip, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind SyncGlyph, Mode=OneWay}" FontSize="15"
                                                      Foreground="{StaticResource HikariPrimaryBrush}" />
                                        </Button>

                                        <Button Click="OnOpenLocalFile" Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="Open the downloaded file">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="15"
                                                      Foreground="{StaticResource HikariTextSoftBrush}" />
                                        </Button>

                                        <Button Click="OnItemEdit" Background="Transparent" BorderThickness="0"
                                                Visibility="{x:Bind ManageVisibility}" ToolTipService.ToolTip="Edit">
                                            <FontIcon Glyph="&#xE70F;" FontSize="15"
                                                      Foreground="{StaticResource HikariPrimaryBrush}" />
                                        </Button>

                                        <Button Click="OnItemDelete" Background="Transparent" BorderThickness="0"
                                                Visibility="{x:Bind ManageVisibility}" ToolTipService.ToolTip="Delete">
                                            <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="IndianRed" />
                                        </Button>

                                        <CheckBox IsChecked="{x:Bind IsMarked, Mode=TwoWay}"
                                                  MinWidth="0" Margin="6,0,0,0"
                                                  ToolTipService.ToolTip="Mark for sync" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Visibility="{x:Bind DetailsVisibility, Mode=OneWay}" Margin="0,10,0,0" Spacing="4">
                                    <Rectangle Height="1" Fill="{StaticResource HikariBorderBrush}" />
                                    <ItemsControl ItemsSource="{x:Bind Details}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="views:DetailRow">
                                                <Grid ColumnSpacing="12" Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                                               FontSize="12.5" TextWrapping="Wrap"
                                                               Foreground="{StaticResource HikariTextSoftBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}"
                                                               FontSize="13" TextWrapping="Wrap"
                                                               Foreground="{StaticResource HikariTextBrush}"
                                                               IsTextSelectionEnabled="True" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="42" Height="42"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="{StaticResource HikariPrimaryBrush}" />

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7BA;" FontSize="34" Foreground="{StaticResource HikariTextSoftBrush}" />
                <TextBlock x:Name="EmptyText" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource HikariTextSoftBrush}" />
            </StackPanel>
        </Grid>

        <!-- ── Sync progress ── -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="5" Visibility="Collapsed" Margin="0,4,0,10" Spacing="4">
            <TextBlock x:Name="ProgressLabel" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{StaticResource HikariTextSoftBrush}" />
            <ProgressBar x:Name="ProgressBarControl" Minimum="0" Maximum="1" Value="0"
                         Foreground="{StaticResource HikariPrimaryBrush}" />
        </StackPanel>
    </Grid>
</views:HikariPage>
