<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Hikari.WindowsClient.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Palette brushes. The colours here are only the Wisteria defaults —
                ThemeManager.Apply() mutates them in place when the theme changes,
                which repaints every live page without rebuilding it.
            -->
            <SolidColorBrush x:Key="HikariPrimaryBrush" Color="#6B4C8A" />
            <SolidColorBrush x:Key="HikariPrimaryDimBrush" Color="#4A2D6B" />
            <SolidColorBrush x:Key="HikariPrimarySoftBrush" Color="#246B4C8A" />
            <SolidColorBrush x:Key="HikariContainerBrush" Color="#E8DCF4" />
            <SolidColorBrush x:Key="HikariAccentBrush" Color="#CEA84C" />
            <SolidColorBrush x:Key="HikariBackgroundBrush" Color="#FAF3E8" />
            <SolidColorBrush x:Key="HikariBackgroundAltBrush" Color="#F3E9F7" />
            <SolidColorBrush x:Key="HikariSurfaceBrush" Color="#FFF8EF" />
            <SolidColorBrush x:Key="HikariBorderBrush" Color="#E8DFD0" />
            <SolidColorBrush x:Key="HikariTextBrush" Color="#2E2420" />
            <SolidColorBrush x:Key="HikariTextSoftBrush" Color="#5C4F45" />
            <SolidColorBrush x:Key="HikariScrimBrush" Color="#142E2420" />

            <LinearGradientBrush x:Key="HikariAccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#6B4C8A" />
                <GradientStop Offset="1" Color="#CEA84C" />
            </LinearGradientBrush>

            <x:Double x:Key="HikariCardRadius">12</x:Double>
            <CornerRadius x:Key="HikariCornerRadius">12</CornerRadius>

            <!-- Washi paper card: the WinUI stand-in for PaperSurface.kt -->
            <Style x:Key="PaperSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource HikariSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HikariBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="HikariHeadlineStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource HikariTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="HikariTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource HikariTextBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="HikariBodyStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource HikariTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="HikariCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource HikariTextSoftBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="HikariSectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{StaticResource HikariTextSoftBrush}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="HikariIconTextStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="16" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
