<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only overlay of the release policy in src/res/xml.

    Permits cleartext to the loopback hosts that ApiClient.getUrl() addresses over http
    (the emulator reaches the development machine at 10.0.2.2), and trusts user-installed
    CAs so an HTTPS debugging proxy can be used.

    This file must stay out of the release variant: the <domain-config> below makes
    Android's RootTrustManager reject the two-argument checkServerTrusted overload that
    Ktor's CIO engine calls, which breaks every TLS handshake. Debug builds are unaffected
    because BuildConfig.INSECURE_TLS swaps in a permissive trust manager.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
