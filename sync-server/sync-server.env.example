# ──────────────────────────────────────────────────────────────────────
# Hikari Sync Server — process environment
#
# Every variable the sync-server reads at startup. Copy to `sync-server.env`
# (git-ignored), fill it in, and pass it to whichever runtime you use:
#   docker run --env-file sync-server.env -p 8080:8080 arteficent/hikari-sync-server
#   udocker run --env-file=sync-server.env hikari          (Termux, see README)
#   gcloud run deploy ... --env-vars-file (convert to YAML)  (Cloud Run)
#
# Format rules (docker / udocker --env-file): one KEY=value per line, no quotes,
# no spaces around "=", and comments only on their own line — anything after the
# "=" is taken literally. Leave a value empty to fall back to appsettings.json.
#
# For the bundled MongoDB + MinIO stack use docker-compose.yml + .env.example instead.
# ──────────────────────────────────────────────────────────────────────


# ═════ Required ═══════════════════════════════════════════════════════

# JWT signing key. MUST be at least 32 bytes — the server refuses to start otherwise.
# Generate one: openssl rand -base64 48
JWT_KEY=
JWT_ISSUER=Hikari-sync-server
JWT_AUDIENCE=Hikari-mobile-app
# Access-token lifetime in hours.
JWT_DURATION_HOURS=12

# Seed credentials for the singleton Root user, used only on the first login
# against an empty database. Change the password, then rotate it after first login.
BOOTSTRAP_ADMIN_USERNAME=root
BOOTSTRAP_ADMIN_PASSWORD=


# ═════ Metadata database ══════════════════════════════════════════════
# DynamoDb (default) or MongoDb. Fill in only the block for the provider you pick.
DATABASE_PROVIDER=MongoDb

# ── MongoDB (DATABASE_PROVIDER=MongoDb) ──
# Self-hosted:   mongodb://user:pass@host:27017/?authSource=admin
# MongoDB Atlas: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE=hikari

# ── AWS DynamoDB (DATABASE_PROVIDER=DynamoDb) ──
# Region is required. Keys are optional: leave empty to use the AWS default
# credential chain (instance role, ~/.aws/credentials, AWS_* variables).
DYNAMODB_REGION=
DYNAMODB_ACCESS_KEY=
DYNAMODB_SECRET_KEY=


# ═════ Object storage (file binaries) ═════════════════════════════════
# S3 (default — AWS S3, Cloudflare R2, any S3-compatible API) or Minio (native MinIO SDK).
OBJECT_STORAGE_PROVIDER=S3
OBJECT_STORAGE_BUCKET=hikari-storage

# S3 provider: AWS region, or "auto" for Cloudflare R2. Ignored when SERVICE_URL is set.
OBJECT_STORAGE_REGION=auto

# Optional for AWS S3 (falls back to the default credential chain); required for R2 / MinIO.
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Custom endpoint. Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# MinIO: http://<minio-host>:9000 (required for the Minio provider). Empty for AWS S3.
OBJECT_STORAGE_SERVICE_URL=

# Minio provider only: client-reachable endpoint signed into presigned URLs, when
# clients reach MinIO over a different host than the server does (e.g. the phone's
# LAN IP: http://192.168.1.20:9000). Empty = same as OBJECT_STORAGE_SERVICE_URL.
OBJECT_STORAGE_PUBLIC_SERVICE_URL=

# true for Cloudflare R2 and MinIO.
OBJECT_STORAGE_FORCE_PATH_STYLE=true


# ═════ Hosting ════════════════════════════════════════════════════════
# The image already sets these; override only when running outside it or changing the port.
# Listen address. On Termux, ports below 1024 are not allowed without root.
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_ENVIRONMENT=Production
# true when TLS is terminated upstream (Cloud Run, reverse proxy) or not used at all.
DISABLE_HTTPS_REDIRECT=true
# Honour X-Forwarded-For / X-Forwarded-Proto from a reverse proxy.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true


# ═════ .NET runtime tuning (optional) ═════════════════════════════════
# The -termux image already sets these; uncomment to apply them elsewhere.
# Required under proot (udocker on Termux): the JIT can't use W^X double mapping there.
# DOTNET_EnableWriteXorExecute=0
# Low-memory devices: workstation GC and aggressive heap compaction (0-9).
# DOTNET_gcServer=0
# DOTNET_GCConserveMemory=7
# Hard cap on the managed heap, in bytes as hex (0x20000000 = 512 MB).
# DOTNET_GCHeapHardLimit=0x20000000
